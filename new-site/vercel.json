{
  "redirects": [
    {
      "source": "/summit-bundle",
      "destination": "/pricing/",
      "permanent": true
    },
    {
      "source": "/summit-bundle/",
      "destination": "/pricing/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
