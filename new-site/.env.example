# Copy to .env.local for `vercel dev`; set the same names in Vercel > Settings >
# Environment Variables (test keys on Preview, live keys on Production).

# Stripe. The webhook signing secret comes from the endpoint you register for
# https://<host>/api/stripe-webhook (event: payment_intent.succeeded), or from
# `stripe listen` locally.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe price ids of the three tickets (Products > price).
STRIPE_PRICE_SUMMIT_1=price_...
STRIPE_PRICE_SUMMIT_2=price_...
STRIPE_PRICE_EVERYTHING=price_...

# Luma (needs Luma Plus). Event id starts with evt-, ticket type ids with ttyp-.
LUMA_API_KEY=...
LUMA_EVENT_ID=evt-...
LUMA_TICKET_SUMMIT_1=ttyp-...
LUMA_TICKET_SUMMIT_2=ttyp-...
LUMA_TICKET_EVERYTHING=ttyp-...
