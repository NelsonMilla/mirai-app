{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "legacy-next-dev",
      "runtimeExecutable": "/opt/homebrew/bin/npm",
      "runtimeArgs": [
        "--prefix",
        "legacy-site",
        "run",
        "dev"
      ],
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      },
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "new-site",
      "runtimeExecutable": "/opt/homebrew/bin/python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4321",
        "-d",
        "new-site"
      ],
      "port": 4321
    },
    {
      "name": "new-site-alt",
      "runtimeExecutable": "/opt/homebrew/bin/python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4325",
        "-d",
        "new-site"
      ],
      "port": 4325
    }
  ]
}
