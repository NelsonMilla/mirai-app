# Copy to .env.local and fill in only what you need.
# The landing page runs fine with NO env vars — everything below is for
# analytics or the dormant checkout/console/invite routes.

# --- Analytics (optional) ---
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Public links shown on the site (optional) ---
NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_LUMA_CALENDAR_URL=
NEXT_PUBLIC_TELEGRAM_INVITE_URL=
NEXT_PUBLIC_DISCORD_INVITE_URL=
NEXT_PUBLIC_X_URL=

# --- Email via Resend (dormant flows) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Stripe (dormant checkout — https://dashboard.stripe.com/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# --- Token signing secret for invite/console links (any random string) ---
TOKEN_SECRET=

# --- Notion databases (dormant whitelist/applications/console) ---
NOTION_API_KEY=
NOTION_WHITELIST_DB_ID=
NOTION_APPLICATIONS_DB_ID=
NOTION_EVENTS_DB_ID=
NOTION_INVITE_CODES_DB_ID=
NOTION_SHOWCASE_DB_ID=

# --- Admin emails (comma-separated; these users see the admin panel in /console) ---
ADMIN_EMAILS=

# --- MailerLite (https://dashboard.mailerlite.com/integrations/api) ---
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=
